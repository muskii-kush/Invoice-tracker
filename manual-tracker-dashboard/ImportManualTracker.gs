function importManualTracker() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var results = [];
  results.push(importSheetIfEmpty_(ss, 'Month-on-Month Invoice Tracker', MOM_HEADERS, MOM_ROWS));
  results.push(importSheetIfEmpty_(ss, 'All Pendency', PENDENCY_HEADERS, PENDENCY_ROWS));
  results.push(importSheetIfEmpty_(ss, 'Vendor Master', VENDOR_MASTER_HEADERS, VENDOR_MASTER_ROWS));

  var order = ['Month-on-Month Invoice Tracker', 'All Pendency', 'Vendor Master'];
  order.forEach(function (name) {
    var sheet = ss.getSheetByName(name);
    if (sheet) {
      ss.setActiveSheet(sheet);
      ss.moveActiveSheet(ss.getNumSheets());
    }
  });

  // The default blank "Sheet1" that every new spreadsheet starts with is
  // just noise once the real tabs exist -- remove it if nothing was ever
  // put in it.
  var blank = ss.getSheetByName('Sheet1');
  if (blank && blank.getLastRow() === 0 && ss.getNumSheets() > 1) {
    ss.deleteSheet(blank);
  }

  var msg = results.join('\n');
  Logger.log(msg);
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { /* no UI when run from the script editor directly */ }
}

function importSheetIfEmpty_(ss, name, headers, rows) {
  var sheet = ss.getSheetByName(name) || ss.insertSheet(name);
  if (sheet.getLastRow() > 0) {
    return name + ': already has data (' + sheet.getLastRow() + ' rows) -- skipped to avoid duplicating. Delete its contents first if you want a fresh import.';
  }
  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  sheet.getRange(1, 1, 1, headers.length)
    .setFontWeight('bold').setFontColor('#FFFFFF').setBackground('#1F4E78')
    .setWrap(true).setVerticalAlignment('middle');
  sheet.setFrozenRows(1);
  sheet.setRowHeight(1, 32);
  if (rows.length) {
    sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
  }
  sheet.autoResizeColumns(1, headers.length);
  return name + ': imported ' + rows.length + ' rows.';
}
