# Copy this file to .env (or export these in your shell) before running sync/backfill.
# Never commit the real .env, credentials.json, or token.json to version control.

# Slack bot token — created in your Slack app's "OAuth & Permissions" page.
# Needs read-only scopes only: channels:history, groups:history, im:history,
# mpim:history, users:read, channels:read, groups:read
SLACK_BOT_TOKEN=xoxb-your-token-here
